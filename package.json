{
  "name": "linkshort-pro",
  "private": true,
  "version": "1.0.0",
  "description": "Professional URL shortener built with Cloudflare Workers and D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute linkshort-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute linkshort-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.30.0"
  }
}
